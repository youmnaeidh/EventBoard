# --- API (apps/api) ---------------------------------------------------------
NODE_ENV=development
PORT=4000
# For Neon Free deployment, use the DIRECT connection URL (no -pooler): startup migrations use advisory locks. Set DATABASE_SSL=true.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventboard
DATABASE_SSL=false
# Signs the session cookie. At least 32 random characters:  openssl rand -hex 32
# Session cookie `Secure` flag: defaults to true in production; set false only for plain-http local runs.
# COOKIE_SECURE=false
JWT_SECRET=change-me-change-me-change-me-change-me
# Insert the sample catalogue + synthetic activity on first start ("false" for a real deployment).
AUTO_SEED=true
# Login/register attempts allowed per IP per 15 minutes.
AUTH_RATE_LIMIT=20
# Directory with the built web app; when set the API serves it (single-origin deploy).
WEB_DIST=
# Leave AI_SERVICE_URL empty to run without the AI service (SQL/keyword fallbacks are used).
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=change-me-shared-secret
AI_TIMEOUT_MS=8000
# Browser origin allowed to access API and receive bearer token for demo auth.
PUBLIC_WEB_ORIGIN=https://youmnaeidh.github.io
# GitHub Pages build (NOT an API secret; included in JS bundle):
# VITE_API_BASE_URL=https://eventboard-api.onrender.com

# --- AI service (services/ai) -----------------------------------------------
# Must equal the API's AI_SERVICE_TOKEN (requests without it are rejected).
# AI_SERVICE_TOKEN is read from the same variable name on both sides.
# Optional: turns the assistant from template answers into grounded LLM answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: dense multilingual embeddings for search (needs requirements-embeddings.txt, ~500 MB).
EMBEDDING_MODEL=
